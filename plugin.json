{
  "id": "graph",
  "name": "PureGraph",
  "permissions": [
    "agents",
    "assets",
    "filesystem",
    "settings"
  ],
  "entrypoint": {
    "kind": "dev-url",
    "url": "http://localhost:5370"
  },
  "app": {
    "id": "plugin.graph",
    "slug": "graph",
    "name": "PureGraph",
    "navigationLabel": "Graph",
    "productName": "ps.graph",
    "kind": "desktop",
    "description": "Build, inspect, style, and export network diagrams from JSON, CSV, or TSV data.",
    "openableFileKinds": [
      "folder"
    ],
    "openableNameSuffixes": [
      ".graph"
    ],
    "openableExtensions": [
      "json",
      "csv",
      "tsv"
    ],
    "createEntities": [
      {
        "id": "graph-package",
        "label": "Graph",
        "description": "Create a new graph package for network analysis and visual mapping.",
        "kind": "package",
        "appSlug": "graph",
        "defaultName": "Untitled graph",
        "packageSuffix": ".graph",
        "packageManifestFile": "manifest.json",
        "packageContentFile": "graph.graph.json",
        "packageAssetsDir": "assets",
        "template": "{\n  \"schemaVersion\": 1,\n  \"title\": \"Untitled graph\",\n  \"layout\": \"cose\",\n  \"style\": {},\n  \"elements\": []\n}\n"
      }
    ],
    "brand": {
      "letter": "g",
      "label": "Graph"
    },
    "agents": {
      "tools": [
        {
          "name": "fn_inspectGraphHealth",
          "risk": "read",
          "description": "Audit the current graph in one read-only call: exact counts, density, average degree, top hubs, isolated nodes, weakly connected components, cycle detection, category breakdown, WCAG/color-blind contrast warnings, and provenance/confidence/synthetic coverage. Replaces repeated getGraphContext + queryGraph + analyzeGraph calls.",
          "inputSchema": {
            "type": "object",
            "properties": {
              "directed": {
                "type": "boolean"
              },
              "category": {
                "type": "string"
              },
              "topHubsLimit": {
                "type": "integer",
                "minimum": 1,
                "maximum": 50
              },
              "includeIsolatedIds": {
                "type": "boolean"
              },
              "includeEvidenceAudit": {
                "type": "boolean"
              }
            },
            "additionalProperties": false
          },
          "requiresApproval": false
        },
        {
          "name": "fn_traceAndFocusSubgraph",
          "risk": "read",
          "description": "Call getGraphContext first to inspect node IDs. Compute a grounded subgraph (shortest path, k-hop neighborhood, connected component, cycle, or query), hydrate node/edge attributes, apply canvas viewAction (focus/select/exclude/none), and fit viewport in one read-only call. Use mode \"reset\" to clear exploration filters.",
          "inputSchema": {
            "type": "object",
            "properties": {
              "mode": {
                "type": "string",
                "enum": [
                  "path",
                  "neighborhood",
                  "component",
                  "query",
                  "cycle",
                  "reset"
                ]
              },
              "start": {
                "type": "string"
              },
              "end": {
                "type": "string"
              },
              "directed": {
                "type": "boolean"
              },
              "depth": {
                "type": "integer",
                "minimum": 1,
                "maximum": 10
              },
              "direction": {
                "type": "string",
                "enum": [
                  "incoming",
                  "outgoing",
                  "both"
                ]
              },
              "componentIndex": {
                "type": "integer",
                "minimum": 0
              },
              "query": {
                "type": "string"
              },
              "category": {
                "type": "string"
              },
              "kind": {
                "type": "string",
                "enum": [
                  "nodes",
                  "edges",
                  "all"
                ]
              },
              "ids": {
                "type": "array",
                "items": {
                  "type": "string"
                }
              },
              "viewAction": {
                "type": "string",
                "enum": [
                  "focus",
                  "select",
                  "exclude",
                  "none"
                ]
              },
              "fit": {
                "type": "boolean"
              },
              "limit": {
                "type": "integer",
                "minimum": 1,
                "maximum": 200
              }
            },
            "required": [
              "mode"
            ],
            "additionalProperties": false
          },
          "requiresApproval": false
        },
        {
          "name": "fn_buildAndSaveGraph",
          "risk": "write",
          "description": "Create and open a NEW graph document from complete nodes and edges (preserving the current graph), optionally apply a measured color-blind-safe category palette (autoPalette), fit viewport, save the .graph package, and return verified counts and artifactPath in one call.",
          "inputSchema": {
            "type": "object",
            "properties": {
              "title": {
                "type": "string"
              },
              "elements": {
                "type": "array",
                "items": {
                  "type": "object",
                  "required": [
                    "data"
                  ]
                }
              },
              "layout": {
                "type": "string",
                "enum": [
                  "cose",
                  "grid",
                  "circle",
                  "concentric",
                  "breadthfirst",
                  "preset"
                ]
              },
              "style": {
                "type": "object"
              },
              "synthetic": {
                "type": "boolean"
              },
              "autoPalette": {
                "type": "boolean"
              },
              "fit": {
                "type": "boolean"
              },
              "save": {
                "type": "boolean"
              }
            },
            "required": [
              "title",
              "elements"
            ],
            "additionalProperties": false
          },
          "requiresApproval": true
        },
        {
          "name": "fn_editGraphAndApply",
          "risk": "write",
          "description": "Stage a validated proposeGraph command batch on the current graph (optionally discarding an obsolete pending proposal), apply atomically as one undoable edit (or leave pending when previewOnly is true), fit viewport, save the .graph package, and return verified counts. Destructive replace/remove commands require allowDestructiveCommands: true.",
          "inputSchema": {
            "type": "object",
            "properties": {
              "title": {
                "type": "string"
              },
              "commands": {
                "type": "array",
                "minItems": 1,
                "maxItems": 1000,
                "items": {
                  "type": "object",
                  "required": [
                    "type"
                  ]
                }
              },
              "previewOnly": {
                "type": "boolean"
              },
              "discardExistingProposal": {
                "type": "boolean"
              },
              "allowDestructiveCommands": {
                "type": "boolean"
              },
              "fit": {
                "type": "boolean"
              },
              "save": {
                "type": "boolean"
              }
            },
            "required": [
              "title",
              "commands"
            ],
            "additionalProperties": false
          },
          "requiresApproval": true,
          "riskWhen": {
            "allowDestructiveCommands": "destructive"
          }
        },
        {
          "name": "fn_polishAndExportGraph",
          "risk": "write",
          "description": "Polish and deliver the current graph in one call: optionally apply a measured category palette (autoPalette), layout, and style overrides (or previewOnly), save a named exploration view, fit viewport, save the .graph package, and export deliverables (html, svg, png, or json).",
          "inputSchema": {
            "type": "object",
            "properties": {
              "autoPalette": {
                "type": "boolean"
              },
              "layout": {
                "type": "string",
                "enum": [
                  "cose",
                  "grid",
                  "circle",
                  "concentric",
                  "breadthfirst",
                  "preset"
                ]
              },
              "direction": {
                "type": "string",
                "enum": [
                  "down",
                  "right"
                ]
              },
              "style": {
                "type": "object"
              },
              "previewOnly": {
                "type": "boolean"
              },
              "discardExistingProposal": {
                "type": "boolean"
              },
              "saveView": {
                "type": "object",
                "properties": {
                  "name": {
                    "type": "string"
                  },
                  "caption": {
                    "type": "string"
                  }
                },
                "required": [
                  "name"
                ],
                "additionalProperties": false
              },
              "fit": {
                "type": "boolean"
              },
              "save": {
                "type": "boolean"
              },
              "exports": {
                "type": "array",
                "items": {
                  "type": "object",
                  "properties": {
                    "format": {
                      "type": "string",
                      "enum": [
                        "html",
                        "svg",
                        "png",
                        "json"
                      ]
                    },
                    "filename": {
                      "type": "string"
                    },
                    "scope": {
                      "type": "string",
                      "enum": [
                        "all",
                        "view",
                        "selected"
                      ]
                    },
                    "attributeKeys": {
                      "type": "array",
                      "items": {
                        "type": "string"
                      }
                    },
                    "includeViews": {
                      "type": "boolean"
                    },
                    "initialViewId": {
                      "type": "string"
                    }
                  },
                  "required": [
                    "format"
                  ],
                  "additionalProperties": false
                }
              }
            },
            "additionalProperties": false
          },
          "requiresApproval": true
        },
        {
          "name": "getGraphContext",
          "risk": "read",
          "description": "Read the current graph: title, documentPath (null while unsaved), node and edge counts, active layout, style, selectedIds, and the nodes and edges with their ids. Call this first — every other tool takes ids from it. Large graphs are capped (truncated: true) with selected elements listed first; counts are always exact. Includes pendingProposal (id, title, impact) or null. Counts describe applied data only.",
          "inputSchema": {
            "type": "object",
            "properties": {}
          },
          "requiresApproval": false
        },
        {
          "name": "createGraph",
          "risk": "write",
          "description": "Create and open a NEW graph document from complete data, preserving the current document. Use for make up data, new examples, unrelated graphs, or start a new graph. This directly creates the requested document, not a proposal replacing the current graph. Provide all nodes and edges together. After creation verify getGraphContext, fit, and saveGraph (or use fn_buildAndSaveGraph to do all steps in one call). Do not use for preview-only requests.",
          "inputSchema": {
            "type": "object",
            "properties": {
              "title": {
                "type": "string"
              },
              "elements": {
                "type": "array",
                "items": {
                  "type": "object",
                  "properties": {
                    "data": {
                      "type": "object"
                    },
                    "position": {
                      "type": "object"
                    }
                  },
                  "required": [
                    "data"
                  ]
                }
              },
              "layout": {
                "type": "string",
                "enum": [
                  "cose",
                  "grid",
                  "circle",
                  "concentric",
                  "breadthfirst",
                  "preset"
                ]
              },
              "style": {
                "type": "object"
              },
              "synthetic": {
                "type": "boolean",
                "description": "True for made-up, illustrative or demo data. Marks all elements accordingly."
              }
            },
            "required": [
              "title",
              "elements"
            ],
            "additionalProperties": false
          },
          "requiresApproval": true
        },
        {
          "name": "proposeGraph",
          "risk": "write",
          "description": "Prepare a validated atomic set of graph edits for user review. Returns pending status and proposalId. For user-authorized work, follow with applyGraphProposal (or use fn_editGraphAndApply to stage, apply, fit, and save in one call); for preview-only requests, leave it pending. Use one proposal for related edits; Undo reverts the whole proposal. Commands: add/replace {elements}; update {ids,data}; rename {id,nextId}; remove {ids}; pin {ids,pinned}; positions {positions}; style {style}; title {title}; layout {name,ids?,direction?}. Read getGraphContext to resolve an existing proposal with applyGraphProposal or discardGraphProposal; do not retry blocked writes. Include data, title, layout and styling in ONE proposal. Nodes must use {data:{id,label,...}}, edges {data:{id,source,target,...}}. Also accepts encodings {encodings:[{channel:nodeSize|nodeColor|nodeShape|edgeWidth,field,values?}]} and views {views:[...]}. Prefer saveGraphView for the current view.",
          "inputSchema": {
            "type": "object",
            "properties": {
              "title": {
                "type": "string"
              },
              "commands": {
                "type": "array",
                "minItems": 1,
                "maxItems": 1000,
                "items": {
                  "type": "object",
                  "properties": {
                    "type": {
                      "type": "string",
                      "enum": [
                        "add",
                        "replace",
                        "update",
                        "rename",
                        "remove",
                        "pin",
                        "positions",
                        "style",
                        "title",
                        "layout",
                        "encodings",
                        "views"
                      ]
                    },
                    "elements": {
                      "type": "array",
                      "items": {
                        "type": "object"
                      }
                    },
                    "encodings": {
                      "type": "array",
                      "items": {
                        "type": "object"
                      }
                    },
                    "views": {
                      "type": "array",
                      "items": {
                        "type": "object"
                      }
                    },
                    "ids": {
                      "type": "array",
                      "items": {
                        "type": "string"
                      }
                    },
                    "data": {
                      "type": "object"
                    },
                    "id": {
                      "type": "string"
                    },
                    "nextId": {
                      "type": "string"
                    },
                    "pinned": {
                      "type": "boolean"
                    },
                    "positions": {
                      "type": "object"
                    },
                    "style": {
                      "type": "object"
                    },
                    "title": {
                      "type": "string"
                    },
                    "name": {
                      "type": "string",
                      "enum": [
                        "cose",
                        "grid",
                        "circle",
                        "concentric",
                        "breadthfirst",
                        "preset"
                      ]
                    },
                    "direction": {
                      "type": "string",
                      "enum": [
                        "down",
                        "right"
                      ]
                    }
                  },
                  "required": [
                    "type"
                  ],
                  "additionalProperties": false
                }
              }
            },
            "required": [
              "title",
              "commands"
            ],
            "additionalProperties": false
          },
          "requiresApproval": true
        },
        {
          "name": "applyGraphProposal",
          "risk": "write",
          "description": "Apply the exact pending proposal identified by proposalId as one undoable edit. Use when the user requested these changes or explicitly approved the pending proposal, including “make the graph”. Do not apply preview-only requests or an unrelated proposal. Rejects stale proposals; verify afterward with getGraphContext.",
          "inputSchema": {
            "type": "object",
            "properties": {
              "proposalId": {
                "type": "string"
              }
            },
            "required": [
              "proposalId"
            ],
            "additionalProperties": false
          },
          "requiresApproval": true
        },
        {
          "name": "saveGraph",
          "risk": "write",
          "description": "Save the current graph into its app-managed .graph package and return the durable artifact path. Call this after graph edits before completing a mission; operates on the applied document, never a pending proposal.",
          "inputSchema": {
            "type": "object",
            "properties": {}
          },
          "requiresApproval": true
        },
        {
          "name": "discoverAppTools",
          "risk": "read",
          "requiresApproval": false,
          "description": "Discover PureGraph's extended specialist tools (17 tools across analysis, editing, exploration, export, import, proposals, read, styling) and composite functions (5 workflows). Prefer calling exposed composite functions and core tools first; use discoverAppTools when an edge case needs a specialist tool, then call it via callExtendedReadTool (for read-only tools) or callExtendedTool (for mutating tools).",
          "inputSchema": {
            "type": "object",
            "properties": {
              "query": {
                "type": "string",
                "description": "Optional keywords describing the capability you need (e.g. \"analysis\", \"editing\", \"exploration\", \"export\", \"import\")."
              },
              "category": {
                "type": "string",
                "description": "Optional category filter (analysis, editing, exploration, export, import, proposals, read, styling, or \"all\")."
              },
              "names": {
                "type": "array",
                "items": {
                  "type": "string"
                },
                "description": "Optional exact tool names to fetch full JSON input schemas for."
              },
              "includeFunctions": {
                "type": "boolean",
                "description": "Include already-exposed composite functions and core tools in the listing (default false: searches extended tools first)."
              }
            }
          }
        },
        {
          "name": "callExtendedReadTool",
          "risk": "read",
          "requiresApproval": false,
          "description": "Call one of PureGraph's read-only extended specialist tools discovered via discoverAppTools (categories: analysis, editing, exploration, export, import, proposals, read, styling). Strictly refuses mutating, destructive, external, or release tools.",
          "inputSchema": {
            "type": "object",
            "properties": {
              "tool": {
                "type": "string",
                "description": "Exact name of a read-only extended tool from discoverAppTools."
              },
              "arguments": {
                "type": "object",
                "description": "Arguments object matching the tool’s inputSchema."
              }
            },
            "required": [
              "tool"
            ]
          }
        },
        {
          "name": "callExtendedTool",
          "risk": "write",
          "requiresApproval": true,
          "riskWhen": {
            "confirmDestructive": "destructive"
          },
          "description": "Call one of PureGraph's mutating extended specialist tools discovered via discoverAppTools (categories: analysis, editing, exploration, export, import, proposals, read, styling). For destructive tools, set confirmDestructive: true after checking with the user. Strictly refuses read-only tools (use callExtendedReadTool), external tools, permanent-delete tools, and release tools.",
          "inputSchema": {
            "type": "object",
            "properties": {
              "tool": {
                "type": "string",
                "description": "Exact name of a mutating extended tool from discoverAppTools."
              },
              "arguments": {
                "type": "object",
                "description": "Arguments object matching the tool’s inputSchema."
              },
              "confirmDestructive": {
                "type": "boolean",
                "description": "Required (true) when calling an extended tool marked risk: \"destructive\"."
              }
            },
            "required": [
              "tool"
            ]
          }
        }
      ]
    }
  }
}
